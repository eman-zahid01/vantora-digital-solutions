{"name":"t:sections.header.name","type":"header","sections":{"announcement-bar":{"type":"announcement-bar","settings":{"auto_rotate":false,"change_slides_speed":5,"color_scheme":"scheme-1","show_line_separator":true,"show_social":false,"enable_country_selector":false,"enable_language_selector":false}},"header":{"type":"header","disabled":true,"settings":{"logo_position":"middle-left","mobile_logo_position":"center","menu":"main-menu","menu_type_desktop":"dropdown","sticky_header_type":"on-scroll-up","show_line_separator":false,"color_scheme":"scheme-1","menu_color_scheme":"scheme-1","enable_country_selector":true,"enable_language_selector":true,"margin_bottom":0,"padding_top":0,"padding_bottom":0}},"custom_liquid_8Rb7UX":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  .vantora-header-wrap {\n    font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    width: 100%;\n    position: relative;\n    z-index: 50;\n  }\n\n  \/* =========================\n     ANNOUNCEMENT BAR\n  ========================= *\/\n\n  .vantora-announcement {\n    background: #0F172A;\n    color: #F1F5F9;\n    min-height: 40px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    font-size: 13px;\n    font-weight: 500;\n    letter-spacing: .2px;\n  }\n\n  .vantora-announcement-inner {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    white-space: nowrap;\n    animation: vantoraAnnouncement 16s linear infinite;\n  }\n\n  .vantora-announcement-dot {\n    width: 7px;\n    height: 7px;\n    background: #14B8A6;\n    border-radius: 50%;\n    display: inline-block;\n    box-shadow: 0 0 10px rgba(20,184,166,.75);\n    flex-shrink: 0;\n  }\n\n  .vantora-announcement strong {\n    color: #14B8A6;\n    font-weight: 700;\n  }\n\n  .vantora-announcement-divider {\n    color: #64748B;\n    font-weight: 600;\n  }\n\n  .vantora-announcement-highlight {\n    color: #F1F5F9;\n    font-weight: 600;\n  }\n\n  @keyframes vantoraAnnouncement {\n    0% {\n      transform: translateX(100%);\n    }\n\n    100% {\n      transform: translateX(-100%);\n    }\n  }\n\n\n  \/* =========================\n     MAIN HEADER\n  ========================= *\/\n\n  .vantora-main-header {\n    background: #ffffff;\n    border-bottom: 1px solid rgba(15,23,42,.08);\n    box-shadow: 0 5px 20px rgba(15,23,42,.05);\n  }\n\n  .vantora-header-container {\n    max-width: 1280px;\n    margin: 0 auto;\n    padding: 17px 28px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 25px;\n  }\n\n\n  \/* =========================\n     LOGO\n  ========================= *\/\n\n  .vantora-logo {\n    text-decoration: none;\n    display: flex;\n    flex-direction: column;\n    line-height: 1.1;\n    flex-shrink: 0;\n  }\n\n  .vantora-logo-main {\n    color: #0F172A;\n    font-size: 22px;\n    font-weight: 800;\n    letter-spacing: -.7px;\n  }\n\n  .vantora-logo-main span {\n    color: #14B8A6;\n  }\n\n  .vantora-logo-sub {\n    color: #64748B;\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n    margin-top: 4px;\n  }\n\n\n  \/* =========================\n     NAVIGATION\n  ========================= *\/\n\n  .vantora-navigation {\n    display: flex;\n    align-items: center;\n    gap: 28px;\n  }\n\n  .vantora-navigation a {\n    position: relative;\n    text-decoration: none;\n    color: #0F172A;\n    font-size: 14px;\n    font-weight: 600;\n    transition: color .25s ease;\n  }\n\n  .vantora-navigation a::after {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    bottom: -7px;\n    width: 0;\n    height: 2px;\n    background: #14B8A6;\n    border-radius: 5px;\n    transition: width .25s ease;\n  }\n\n  .vantora-navigation a:hover {\n    color: #14B8A6;\n  }\n\n  .vantora-navigation a:hover::after {\n    width: 100%;\n  }\n\n\n  \/* =========================\n     GET STARTED BUTTON\n  ========================= *\/\n\n  .vantora-header-cta {\n    text-decoration: none;\n    background: #14B8A6;\n    color: #ffffff !important;\n    padding: 12px 20px;\n    border-radius: 8px;\n    font-size: 13px;\n    font-weight: 700;\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    transition: all .25s ease;\n    box-shadow: 0 6px 18px rgba(20,184,166,.18);\n    white-space: nowrap;\n  }\n\n  .vantora-header-cta:hover {\n    background: #0F172A;\n    transform: translateY(-2px);\n    box-shadow: 0 9px 22px rgba(15,23,42,.16);\n  }\n\n  .vantora-header-cta span {\n    transition: transform .25s ease;\n  }\n\n  .vantora-header-cta:hover span {\n    transform: translateX(3px);\n  }\n\n\n  \/* =========================\n     TABLET\n  ========================= *\/\n\n  @media (max-width: 1050px) {\n\n    .vantora-navigation {\n      gap: 18px;\n    }\n\n    .vantora-navigation a {\n      font-size: 13px;\n    }\n\n    .vantora-header-container {\n      padding-left: 20px;\n      padding-right: 20px;\n    }\n  }\n\n\n  \/* =========================\n     MOBILE\n  ========================= *\/\n\n  @media (max-width: 900px) {\n\n    .vantora-header-container {\n      padding: 15px 18px;\n    }\n\n    .vantora-navigation {\n      display: none;\n    }\n\n    .vantora-logo-main {\n      font-size: 20px;\n    }\n\n    .vantora-header-cta {\n      padding: 10px 15px;\n      font-size: 12px;\n    }\n  }\n\n\n  \/* =========================\n     SMALL MOBILE\n  ========================= *\/\n\n  @media (max-width: 480px) {\n\n    .vantora-announcement {\n      min-height: 36px;\n      font-size: 11px;\n    }\n\n    .vantora-announcement-inner {\n      gap: 7px;\n    }\n\n    .vantora-logo-main {\n      font-size: 18px;\n    }\n\n    .vantora-logo-sub {\n      font-size: 8px;\n      letter-spacing: 1.3px;\n    }\n\n    .vantora-header-cta {\n      padding: 9px 12px;\n      border-radius: 7px;\n    }\n  }\n\n<\/style>\n\n\n<div class=\"vantora-header-wrap\">\n\n  <!-- =========================\n       ANNOUNCEMENT BAR\n  ========================= -->\n\n  <div class=\"vantora-announcement\">\n\n    <div class=\"vantora-announcement-inner\">\n\n      <span class=\"vantora-announcement-dot\"><\/span>\n\n      <span>\n        Ready to grow your business?\n      <\/span>\n\n      <span class=\"vantora-announcement-divider\">\n        →\n      <\/span>\n\n      <strong>\n        Let's build your digital presence.\n      <\/strong>\n\n      <span class=\"vantora-announcement-divider\">\n        →\n      <\/span>\n\n      <span class=\"vantora-announcement-highlight\">\n        Smart strategy. Better results.\n      <\/span>\n\n    <\/div>\n\n  <\/div>\n\n\n  <!-- =========================\n       HEADER\n  ========================= -->\n\n  <header class=\"vantora-main-header\">\n\n    <div class=\"vantora-header-container\">\n\n\n      <!-- LOGO -->\n\n      <a href=\"\/\" class=\"vantora-logo\">\n\n        <span class=\"vantora-logo-main\">\n          Vantora<span>.<\/span>\n        <\/span>\n\n        <span class=\"vantora-logo-sub\">\n          Digital Solutions\n        <\/span>\n\n      <\/a>\n\n\n      <!-- NAVIGATION -->\n\n      <nav class=\"vantora-navigation\">\n\n        <a href=\"\/\">\n          Home\n        <\/a>\n\n        <a href=\"\/pages\/about-us\">\n          About\n        <\/a>\n\n        <a href=\"\/pages\/our-services\">\n          Services\n        <\/a>\n\n        <a href=\"\/pages\/our-work\">\n          Our Work\n        <\/a>\n\n        <a href=\"\/pages\/pricing\">\n          Pricing\n        <\/a>\n\n        <a href=\"\/pages\/contact\">\n          Contact\n        <\/a>\n\n      <\/nav>\n\n\n      <!-- CTA -->\n\n      <a href=\"\/pages\/contact\" class=\"vantora-header-cta\">\n\n        Get Started\n\n        <span>→<\/span>\n\n      <\/a>\n\n\n    <\/div>\n\n  <\/header>\n\n<\/div>","color_scheme":"","padding_top":0,"padding_bottom":0}}},"order":["announcement-bar","header","custom_liquid_8Rb7UX"]}